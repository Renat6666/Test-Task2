# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
LOG_LEVEL=INFO

# ── Cookies / sessions ───────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
PASSWORD_RESET_TIMEOUT=86400

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
USE_SQLITE=0

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=inventory

# ── Business rules ───────────────────────────────────────────────────────────
TRANSACTION_THROTTLE_RATE=50/min
AUTH_THROTTLE_RATE=30/min
REPORT_CACHE_TTL=300
API_PAGE_SIZE=20

# ── Email: Gmail SMTP ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=t88787377@gmail.com
# App password without the spaces Google shows it with.
EMAIL_HOST_PASSWORD=kcjltgdmhlrmmoct
# Gmail only accepts mail sent as the authenticated account.
DEFAULT_FROM_EMAIL=t88787377@gmail.com
PASSWORD_RESET_URL_TEMPLATE=http://localhost:8000/api/auth/password-reset/confirm/?uid={uid}&token={token}

# ── Ports published on the host ──────────────────────────────────────────────
API_PUBLISHED_PORT=8000
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379

# ── Container runtime ────────────────────────────────────────────────────────
PYTHONUSERBASE=/pydeps
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
